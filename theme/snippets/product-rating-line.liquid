{%- comment -%}
  Snippet: product-rating-line
  Uso: {% render 'product-rating-line' %}
  Va ARRIBA del título del producto.
{%- endcomment -%}

{%- assign pt_rating = 4.9 -%}
{%- assign pt_review_count = "3.850" -%}

{% style %}
  .pt-social-proof {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 4px 0 4px;
  }
  .pt-social-proof__stars {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    line-height: 0;
  }
  .pt-social-proof__star-box {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #3DAA4E;
    border-radius: 3px;
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }
  .pt-social-proof__stars svg {
    width: 12px;
    height: 12px;
    fill: #fff;
    flex-shrink: 0;
    display: block;
  }
  .pt-social-proof__text {
    font-size: 0.85rem;
    color: #767676;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
  }

  .pt-rating-divider {
    height: 1px;
    background: rgba(20, 15, 10, 0.16);
    margin: 10px 0 12px;
  }
{% endstyle %}

<div class="pt-social-proof">
  <span class="pt-social-proof__stars">
    {%- for i in (1..5) -%}
      <span class="pt-social-proof__star-box">
        <svg viewBox="0 0 20 20"><path d="M10 1l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6L1.3 7.2l6.1-.6z"/></svg>
      </span>
    {%- endfor -%}
  </span>
  <span class="pt-social-proof__text">({{ pt_rating }} / {{ pt_review_count }} reseñas)</span>
</div>
<div class="pt-rating-divider"></div>
