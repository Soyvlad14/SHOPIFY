{%- comment -%}
  Snippet: product-social-proof
  Uso: {% render 'product-social-proof' %}
  Franja de confianza (envío / devolución / familiar) + últimas unidades.
  Colocar cerca del precio, antes del selector de color/talla.
{%- endcomment -%}

{% style %}
  .pt-trust-badges {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0 0 4px;
  }
  .pt-trust-badges .pt-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    color: #2b2620;
  }
  .pt-badge__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
  }
  .pt-badge__icon-wrap svg {
    width: 15px;
    height: 15px;
    display: block;
  }
  .pt-badge__label {
    font-weight: 400;
  }
  .pt-badge__label strong {
    font-weight: 700;
  }
  .pt-badge--express .pt-badge__icon-wrap {
    background: #FFCC00;
  }
  .pt-badge--express .pt-badge__icon-wrap svg {
    width: 26px;
    height: 26px;
  }
  .pt-badge--warranty .pt-badge__icon-wrap {
    background: transparent;
    overflow: visible;
    width: 30px;
    height: 30px;
  }
  .pt-badge--warranty .pt-badge__icon-wrap svg {
    width: 30px;
    height: 30px;
  }
  .pt-badge--familiar .pt-badge__icon-wrap svg {
    width: 26px;
    height: 26px;
  }

  .pt-low-stock {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    color: #c05621;
    margin: 0;
  }
  .pt-low-stock__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #dd6b20;
    animation: pt-pulse 1.4s ease-in-out infinite;
    flex-shrink: 0;
  }
  .pt-low-stock__label {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  @keyframes pt-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.75); }
  }
{% endstyle %}

<div data-pt-social-proof>
<div class="pt-trust-badges">
  <div class="pt-badge pt-badge--express">
    <span class="pt-badge__icon-wrap">
      <svg viewBox="0 0 40 40" role="img" aria-label="DHL Express">
        <circle cx="20" cy="20" r="20" fill="#FFCC00"/>
        <text x="20" y="18" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="800" font-size="12" fill="#D40511" letter-spacing="-0.3">DHL</text>
        <text x="20" y="27" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="600" font-size="5.5" fill="#D40511" letter-spacing="0.3">EXPRESS</text>
      </svg>
    </span>
    <span class="pt-badge__label"><strong>Envío Gratis</strong> Express · DHL</span>
  </div>
  <div class="pt-badge pt-badge--warranty">
    <span class="pt-badge__icon-wrap">
      <svg viewBox="0 0 64 64" role="img" aria-label="Devolución de paquete" xmlns="http://www.w3.org/2000/svg">
        <path d="M55.6 43 A26 26 0 1 0 7.6 23.1 L16 26.2 A17 17 0 1 1 47.4 39.2 Z" fill="#171310"/>
        <polygon points="2,19 18,9 18,34" fill="#171310"/>
        <path d="M34 30 56 42 34 54 12 42 Z" fill="#171310"/>
        <path d="M12 42 34 54 34 64 12 52 Z" fill="#171310"/>
        <path d="M56 42 34 54 34 64 56 52 Z" fill="#171310"/>
        <path d="M12 42 34 54 56 42" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <path d="M34 54 34 64" stroke="#FFFFFF" stroke-width="1.6" stroke-linecap="round" fill="none"/>
      </svg>
    </span>
    <span class="pt-badge__label">Garantía de <strong>devolución</strong> de 30 días</span>
  </div>
  <div class="pt-badge pt-badge--familiar">
    <span class="pt-badge__icon-wrap">
      <svg viewBox="0 0 26 26" role="img" aria-label="Bandera de México">
        <rect width="26" height="26" fill="#FFFFFF"/>
        <rect width="8.67" height="26" fill="#006341"/>
        <rect x="17.33" width="8.67" height="26" fill="#CE1126"/>
        <circle cx="13" cy="13" r="2.4" fill="#8B5E3C"/>
        <path d="M13 11.3c.55 0 1 .5 1 1.05s-.45 1.1-1 1.6c-.55-.5-1-1.05-1-1.6s.45-1.05 1-1.05Z" fill="#4C7A3D"/>
      </svg>
    </span>
    <span class="pt-badge__label">Empresa <strong>Familiar</strong> Mexicana</span>
  </div>
</div>

<div class="pt-low-stock">
  <span class="pt-low-stock__dot"></span>
  <span class="pt-low-stock__label">Últimas unidades disponibles</span>
</div>
</div>

<script>
  (function () {
    function pt_dedupe_social_proof() {
      var nodes = document.querySelectorAll('[data-pt-social-proof]');
      for (var i = 1; i < nodes.length; i++) {
        nodes[i].remove();
      }
    }
    pt_dedupe_social_proof();
    if (window.MutationObserver) {
      var pt_observer = new MutationObserver(pt_dedupe_social_proof);
      pt_observer.observe(document.documentElement, { childList: true, subtree: true });
    }
  })();
</script>
