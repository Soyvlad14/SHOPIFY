{%- comment -%}
  Snippet: product-social-proof
  Uso: {% render 'product-social-proof' %}
  Franja de confianza (envío / devolución / familiar) + últimas unidades.
  Colocar cerca del precio, antes del selector de color/talla.
{%- endcomment -%}

{% style %}
  .pt-trust-badges {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0 0 4px;
  }
  .pt-trust-badges .pt-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    color: #2b2620;
  }
  .pt-badge__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
  }
  .pt-badge__icon-wrap svg {
    width: 15px;
    height: 15px;
    display: block;
  }
  .pt-badge__label {
    font-weight: 400;
  }
  .pt-badge__label strong {
    font-weight: 700;
  }
  .pt-badge--express .pt-badge__icon-wrap {
    background: #FFCC00;
  }
  .pt-badge--express .pt-badge__icon-wrap svg {
    width: 26px;
    height: 26px;
  }
  .pt-badge--warranty .pt-badge__icon-wrap {
    background: transparent;
    overflow: visible;
    width: 28px;
    height: 28px;
  }
  .pt-badge--warranty .pt-badge__icon-wrap svg {
    width: 28px;
    height: 28px;
  }
  .pt-badge--familiar .pt-badge__icon-wrap {
    background: transparent;
    border-radius: 5px;
    width: 22px;
    height: 27px;
  }
  .pt-badge--familiar .pt-badge__icon-wrap svg {
    width: 22px;
    height: 27px;
  }

  .pt-low-stock {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    color: #c05621;
    margin: 0;
  }
  .pt-low-stock__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #dd6b20;
    animation: pt-pulse 1.4s ease-in-out infinite;
    flex-shrink: 0;
  }
  .pt-low-stock__label {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  @keyframes pt-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.75); }
  }
{% endstyle %}

<div data-pt-social-proof>
<div class="pt-trust-badges">
  <div class="pt-badge pt-badge--express">
    <span class="pt-badge__icon-wrap">
      <svg viewBox="0 0 40 40" role="img" aria-label="DHL Express">
        <circle cx="20" cy="20" r="20" fill="#FFCC00"/>
        <text x="20" y="18" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="800" font-size="12" fill="#D40511" letter-spacing="-0.3">DHL</text>
        <text x="20" y="27" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="600" font-size="5.5" fill="#D40511" letter-spacing="0.3">EXPRESS</text>
      </svg>
    </span>
    <span class="pt-badge__label"><strong>Envío Gratis</strong> Express · DHL</span>
  </div>
  <div class="pt-badge pt-badge--warranty">
    <span class="pt-badge__icon-wrap">
      <svg viewBox="0 0 32 32" role="img" aria-label="Devolución fácil de paquete" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M26.6 11.2A10.5 10.5 0 1 1 15.9 4.83" stroke="#171310" stroke-width="1.7" stroke-linecap="round"/>
        <path d="M27.25 4.4l.45 6.75-6.3-2.35 5.85-4.4Z" fill="#171310"/>
        <path d="M16 9.6 23 13.7 16 17.8 9 13.7 16 9.6Z" fill="#F1F1EF" stroke="#171310" stroke-width="0.6" stroke-linejoin="round"/>
        <path d="M9 13.7 16 17.8V25.5L9 21.4V13.7Z" fill="#403C38" stroke="#171310" stroke-width="0.5" stroke-linejoin="round"/>
        <path d="M23 13.7 16 17.8V25.5L23 21.4V13.7Z" fill="#171310"/>
        <path d="M12.3 11.85 18.75 15.65" stroke="#B9B4AC" stroke-width="0.5" stroke-linecap="round"/>
        <path d="M13.4 12.2 12.3 15" stroke="#171310" stroke-width="0.6" stroke-linecap="round"/>
      </svg>
    </span>
    <span class="pt-badge__label">Garantía de <strong>devolución</strong> de 30 días</span>
  </div>
  <div class="pt-badge pt-badge--familiar">
    <span class="pt-badge__icon-wrap">
      <svg viewBox="0 0 22 27" role="img" aria-label="Bandera de México">
        <rect width="22" height="27" fill="#FFFFFF"/>
        <rect width="7.33" height="27" fill="#006341"/>
        <rect x="14.67" width="7.33" height="27" fill="#CE1126"/>
        <circle cx="11" cy="13.5" r="2.5" fill="#8B5E3C"/>
        <path d="M11 11.6c.6 0 1.05.5 1.05 1.1s-.45 1.15-1.05 1.7c-.6-.55-1.05-1.1-1.05-1.7s.45-1.1 1.05-1.1Z" fill="#5B7C3E"/>
      </svg>
    </span>
    <span class="pt-badge__label">Empresa <strong>Familiar</strong> Mexicana</span>
  </div>
</div>

<div class="pt-low-stock">
  <span class="pt-low-stock__dot"></span>
  <span class="pt-low-stock__label">Últimas unidades disponibles</span>
</div>
</div>

<script>
  (function () {
    function pt_dedupe_social_proof() {
      var nodes = document.querySelectorAll('[data-pt-social-proof]');
      for (var i = 1; i < nodes.length; i++) {
        nodes[i].remove();
      }
    }
    pt_dedupe_social_proof();
    if (window.MutationObserver) {
      var pt_observer = new MutationObserver(pt_dedupe_social_proof);
      pt_observer.observe(document.documentElement, { childList: true, subtree: true });
    }
  })();
</script>
