{%- comment -%}
  Snippet: product-social-proof
  Uso: {% render 'product-social-proof' %}
  Franja de confianza (envío / devolución / familiar) + últimas unidades.
  Colocar cerca del precio, antes del selector de color/talla.
{%- endcomment -%}

{% style %}
  .pt-social-proof {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 4px 0 4px;
  }
  .pt-social-proof__stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: #2E8B57;
  }
  .pt-social-proof__stars svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    display: block;
  }
  .pt-social-proof__text {
    font-size: 0.9rem;
    color: #2b2620;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.3px;
    white-space: nowrap;
    display: inline-block;
    vertical-align: middle;
  }
  .pt-social-proof__count {
    margin-right: 2px;
  }
  .pt-social-proof__plus {
    font-family: Arial, Helvetica, sans-serif;
    font-weight: 700;
    vertical-align: baseline;
    margin-right: 3px;
  }
  .pt-social-proof__label {
    display: inline-block;
    position: relative;
    top: -2px;
  }

  .pt-trust-badges {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0 0 4px;
  }
  .pt-trust-badges .pt-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.92rem;
    color: #2b2620;
  }
  .pt-badge__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
  }
  .pt-badge__icon-wrap svg {
    width: 15px;
    height: 15px;
    display: block;
  }
  .pt-badge__label {
    font-weight: 700;
  }
  .pt-badge--express .pt-badge__icon-wrap {
    background: #FFCC00;
  }
  .pt-badge--express .pt-badge__icon-wrap svg {
    width: 26px;
    height: 26px;
  }
  .pt-badge--warranty .pt-badge__icon-wrap {
    background: #E8F4EC;
    color: #2E8B57;
  }
  .pt-badge--familiar .pt-badge__icon-wrap {
    background: #FBEFE0;
    color: #C0793C;
  }

  .pt-low-stock {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    color: #c05621;
    margin: 0;
  }
  .pt-low-stock__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #dd6b20;
    animation: pt-pulse 1.4s ease-in-out infinite;
    flex-shrink: 0;
  }
  .pt-low-stock__label {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  @keyframes pt-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.75); }
  }
{% endstyle %}

<div class="pt-trust-badges">
  <div class="pt-badge pt-badge--express">
    <span class="pt-badge__icon-wrap">
      <svg viewBox="0 0 40 40" role="img" aria-label="DHL Express">
        <circle cx="20" cy="20" r="20" fill="#FFCC00"/>
        <text x="20" y="18" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="800" font-size="12" fill="#D40511" letter-spacing="-0.3">DHL</text>
        <text x="20" y="27" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="600" font-size="5.5" fill="#D40511" letter-spacing="0.3">EXPRESS</text>
      </svg>
    </span>
    <span class="pt-badge__label">Envío Gratis Express · DHL</span>
  </div>
  <div class="pt-badge pt-badge--warranty">
    <span class="pt-badge__icon-wrap">
      <svg viewBox="0 0 20 20" fill="currentColor"><path d="M11.571 1.05882C11.571 0.750194 11.8198 0.5 12.1266 0.5H13.4572C17.0692 0.5 20 3.45304 20 7.08924C20 10.7255 17.0692 13.6785 13.4572 13.6785L1.89992 13.7105L1.30855 13.1197L1.89992 12.5484L13.4572 12.5608C16.4541 12.5608 18.8889 10.1096 18.8889 7.08924C18.8889 4.06891 16.4541 1.61765 13.4572 1.61765H12.1266C11.8198 1.61765 11.571 1.36745 11.571 1.05882Z"/><path d="M6.00311 7.00677C6.22317 6.7917 6.57489 6.79679 6.78871 7.01815C7.00252 7.2395 6.99746 7.59329 6.7774 7.80836L6.00311 7.00677ZM1.30855 13.1197L6.73968 18.5463C6.9565 18.7647 6.95627 19.1185 6.73917 19.3366C6.52207 19.5547 6.17031 19.5544 5.9535 19.3361L0.162462 13.5034C0.0572388 13.3974 -0.00128425 13.2533 2.13868e-05 13.1036C0.00132703 12.9538 0.0623521 12.8108 0.169407 12.7067C0.3269 12.5535 1.78474 11.1291 3.20439 9.74186L6.00311 7.00677L6.7774 7.80836L3.97862 10.5435C2.95441 11.5444 1.8705 12.5709 1.30855 13.1197Z"/></svg>
    </span>
    <span class="pt-badge__label">Garantía de devolución de 30 días</span>
  </div>
  <div class="pt-badge pt-badge--familiar">
    <span class="pt-badge__icon-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
    </span>
    <span class="pt-badge__label">Empresa 100% familiar</span>
  </div>
</div>

<div class="pt-low-stock">
  <span class="pt-low-stock__dot"></span>
  <span class="pt-low-stock__label">Últimas unidades disponibles</span>
</div>
