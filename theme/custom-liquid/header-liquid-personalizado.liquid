<style>
  #ultimo-dia-bar {
    background: linear-gradient(135deg, #5a3826, #3b2418);
    padding: 10px 16px 12px;
    text-align: center;
  }

  #ultimo-dia-bar .ud-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  #ultimo-dia-bar .ud-headline {
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-size: 12px;
    font-weight: 600;
    color: #f5ece1;
  }

  #ultimo-dia-bar .ud-timer {
    font-family: 'Courier New', monospace;
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum";
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #e8c07d;
  }

  @media (max-width: 480px) {
    #ultimo-dia-bar .ud-headline {
      font-size: 10.5px;
      letter-spacing: 1px;
    }
    #ultimo-dia-bar .ud-timer {
      font-size: 17px;
    }
  }
</style>

<div id="ultimo-dia-bar">
  <div class="ud-inner">
    <span class="ud-headline">Último día &mdash; Hasta 60% de descuento</span>
    <span class="ud-timer" id="ud-tiempo">00:00:00</span>
  </div>
</div>

<script>
  function actualizarUltimoDiaTimer() {
    const ahora = new Date();
    const medianoche = new Date();
    medianoche.setHours(24, 0, 0, 0);
    const msRestante = medianoche - ahora;

    const horas = Math.floor(msRestante / 3600000);
    const minutos = Math.floor((msRestante % 3600000) / 60000);
    const segundos = Math.floor((msRestante % 60000) / 1000);

    const pad = (n) => String(n).padStart(2, '0');
    document.getElementById('ud-tiempo').innerText = `${pad(horas)}:${pad(minutos)}:${pad(segundos)}`;
  }

  actualizarUltimoDiaTimer();
  setInterval(actualizarUltimoDiaTimer, 1000);
</script>
{%- comment -%}
