{% style %}
  .reviews-carousel-{{ section.id }} {
    --rc-accent: {{ section.settings.accent_color }};
    --rc-bg: {{ section.settings.bg_color }};
    padding: 32px 0 28px;
    text-align: center;
    background-color: var(--rc-bg);
  }
  .reviews-carousel-{{ section.id }} .rc-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Header */
  .reviews-carousel-{{ section.id }} .rc-heading {
    font-size: clamp(1.3rem, 2.8vw, 1.75rem);
    margin: 0 0 14px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: #221d16;
  }
  .reviews-carousel-{{ section.id }} .rc-summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    margin-bottom: 8px;
  }
  .reviews-carousel-{{ section.id }} .rc-summary__label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6b6459;
  }
  .reviews-carousel-{{ section.id }} .rc-summary__score-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .reviews-carousel-{{ section.id }} .rc-summary__score {
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1;
    color: #221d16;
  }
  .reviews-carousel-{{ section.id }} .rc-summary__max {
    font-size: 0.9rem;
    color: #948c7e;
  }
  .reviews-carousel-{{ section.id }} .rc-stars {
    display: inline-flex;
    gap: 2px;
    align-self: center;
  }
  .reviews-carousel-{{ section.id }} .rc-stars svg {
    width: 14px;
    height: 14px;
  }
  .reviews-carousel-{{ section.id }} .rc-stars--summary svg {
    width: 17px;
    height: 17px;
  }
  .reviews-carousel-{{ section.id }} .rc-star {
    color: var(--rc-accent);
  }
  .reviews-carousel-{{ section.id }} .rc-star--empty {
    color: rgba(0, 0, 0, 0.15);
  }

  .reviews-carousel-{{ section.id }} .rc-verified {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin: 4px 0 22px;
    font-size: 0.8rem;
    color: #6b6459;
  }
  .reviews-carousel-{{ section.id }} .rc-verified svg {
    width: 14px;
    height: 14px;
    color: #2f6b4f;
    flex-shrink: 0;
  }

  /* Track */
  .reviews-carousel-{{ section.id }} .rc-track {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: 4px 2px 14px;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 20px;
  }
  .reviews-carousel-{{ section.id }} .rc-track::-webkit-scrollbar {
    height: 4px;
  }
  .reviews-carousel-{{ section.id }} .rc-track::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.08);
    border-radius: 10px;
  }
  .reviews-carousel-{{ section.id }} .rc-track::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.25);
    border-radius: 10px;
  }
  .reviews-carousel-{{ section.id }} .rc-track {
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.25) rgba(0, 0, 0, 0.08);
  }

  /* Cards */
  .reviews-carousel-{{ section.id }} .review-card {
    flex: 0 0 190px;
    scroll-snap-align: start;
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.09);
    border-radius: 12px;
    padding: 16px 14px;
    text-align: left;
    display: flex;
    flex-direction: column;
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.05);
  }
  .reviews-carousel-{{ section.id }} .review-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 8px;
  }
  .reviews-carousel-{{ section.id }} .review-card__badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 0.58rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #2f6b4f;
    background: rgba(47, 107, 79, 0.09);
    padding: 2px 6px;
    border-radius: 20px;
    white-space: nowrap;
  }
  .reviews-carousel-{{ section.id }} .review-card__badge svg {
    width: 9px;
    height: 9px;
    flex-shrink: 0;
  }
  .reviews-carousel-{{ section.id }} .review-card__title {
    font-size: 0.92rem;
    font-weight: 600;
    margin: 0 0 5px;
    line-height: 1.3;
    color: #221d16;
  }
  .reviews-carousel-{{ section.id }} .review-card__text {
    font-size: 0.8rem;
    line-height: 1.45;
    margin: 0;
    flex: 1;
    color: #5a5349;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    line-clamp: 3;
    overflow: hidden;
  }
  .reviews-carousel-{{ section.id }} .review-card__footer {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }
  .reviews-carousel-{{ section.id }} .review-card__avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .reviews-carousel-{{ section.id }} .review-card__avatar--initial {
    background: rgba(184, 134, 11, 0.14);
    color: var(--rc-accent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.68rem;
    font-weight: 700;
  }
  .reviews-carousel-{{ section.id }} .review-card__avatar--photo {
    object-fit: cover;
  }
  .reviews-carousel-{{ section.id }} .review-card__author {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 600;
    color: #221d16;
  }

  @media (min-width: 700px) {
    .reviews-carousel-{{ section.id }} .review-card {
      flex-basis: 222px;
    }
  }
{% endstyle %}

{% capture rc_star_svg %}<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z"/></svg>{% endcapture %}
{% capture rc_check_svg %}<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>{% endcapture %}

<div class="reviews-carousel-{{ section.id }}">
  <div class="rc-inner">

    <h2 class="rc-heading">{{ section.settings.heading }}</h2>

    <div class="rc-summary">
      <span class="rc-summary__label">{{ section.settings.summary_label }}</span>
      <div class="rc-summary__score-row">
        <span class="rc-summary__score">{{ section.settings.rating }}</span>
        <span class="rc-summary__max">/ {{ section.settings.rating_max }}</span>
        <span class="rc-stars rc-stars--summary" aria-hidden="true">
          {% assign full_stars = section.settings.rating | round %}
          {% for i in (1..section.settings.rating_max) %}
            {% if i <= full_stars %}
              <span class="rc-star">{{ rc_star_svg }}</span>
            {% else %}
              <span class="rc-star rc-star--empty">{{ rc_star_svg }}</span>
            {% endif %}
          {% endfor %}
        </span>
      </div>
    </div>

    <p class="rc-verified">
      {{ rc_check_svg }}
      {{ section.settings.reviews_count_text }}
    </p>

    <div class="rc-track">
      {% for block in section.blocks %}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="review-card__top">
            <span class="rc-stars" aria-hidden="true">
              {% for i in (1..5) %}<span class="rc-star">{{ rc_star_svg }}</span>{% endfor %}
            </span>
            <span class="review-card__badge">
              {{ rc_check_svg }}
              {{ section.settings.verified_text }}
            </span>
          </div>
          <h3 class="review-card__title">{{ block.settings.title }}</h3>
          <p class="review-card__text">{{ block.settings.text }}</p>
          <div class="review-card__footer">
            {% if block.settings.photo %}
              <img
                class="review-card__avatar review-card__avatar--photo"
                src="{{ block.settings.photo | image_url: width: 96 }}"
                width="24"
                height="24"
                alt="{{ block.settings.author | escape }}"
                loading="lazy"
              >
            {% else %}
              <span class="review-card__avatar review-card__avatar--initial">{{ block.settings.author | slice: 0 }}</span>
            {% endif %}
            <p class="review-card__author">{{ block.settings.author }}</p>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Carrusel de resenas",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Color de estrellas y acentos",
      "default": "#B8860B"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titulo",
      "default": "Las opiniones hablan por si solas"
    },
    {
      "type": "text",
      "id": "summary_label",
      "label": "Etiqueta de valoracion",
      "default": "Valoracion excelente"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Valoracion",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 4.8
    },
    {
      "type": "number",
      "id": "rating_max",
      "label": "Valoracion maxima",
      "default": 5
    },
    {
      "type": "text",
      "id": "reviews_count_text",
      "label": "Texto de numero de resenas",
      "default": "Basado en 5067 resenas verificadas"
    },
    {
      "type": "text",
      "id": "verified_text",
      "label": "Texto de insignia verificada",
      "default": "Compra verificada"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Resena",
      "settings": [
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Foto de la clienta (opcional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titulo de la resena",
          "default": "Excelente calidad"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto de la resena",
          "default": "Escribe aqui la resena de tu clienta."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Nombre",
          "default": "Nombre Apellido"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carrusel de resenas",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
