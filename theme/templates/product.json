        "returns_title": "Devolución en 30 días",
        "returns_text": "Pruébalo en casa sin ningún riesgo",
        "payment_title": "Pago 100% seguro",
        "payment_text": "Visa, Mastercard, Apple Pay y más",
        "customers_count": "5.000"
      }
